<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><c:set var="pageTitle" value="자산 변경 승인"/><%@ include file="../common/header.jsp" %><div class="page-head"><div><span class="eyebrow">APPROVAL</span><h1>고정자산 변경 승인</h1><p>승인 시 신청 정보가 자산 Master에 Transaction으로 반영됩니다.</p></div></div><section class="panel"><form class="filter"><label>상태<select name="status"><option ${status eq 'PENDING'?'selected':''}>PENDING</option><option ${status eq 'APPROVED'?'selected':''}>APPROVED</option><option ${status eq 'REJECTED'?'selected':''}>REJECTED</option><option value="">전체</option></select></label><button class="btn">조회</button></form><table><thead><tr><th>번호</th><th>자산</th><th>신청자</th><th>변경 부서</th><th>변경 사용자</th><th>변경 위치</th><th>사유</th><th>상태</th><th>처리</th></tr></thead><tbody><c:forEach items="${requests}" var="r"><tr><td>${r.requestId}</td><td><code>${r.assetNo}</code><br>${r.assetName}</td><td>${r.requesterId}</td><td>${r.requestedDepartment}</td><td>${r.requestedOwner}</td><td>${r.requestedLocation}</td><td>${r.reason}</td><td><span class="badge ${r.requestStatus eq 'APPROVED'?'ok':(r.requestStatus eq 'REJECTED'?'danger':'warn')}">${r.requestStatus}</span></td><td><c:if test="${r.requestStatus eq 'PENDING'}"><form method="post" action="${pageContext.request.contextPath}/assets/approvals/${r.requestId}" class="button-row"><button class="btn small primary" name="action" value="approve">승인</button><button class="btn small" name="action" value="reject">반려</button></form></c:if></td></tr></c:forEach></tbody></table></section><%@ include file="../common/footer.jsp" %>
