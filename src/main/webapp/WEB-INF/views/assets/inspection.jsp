<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><c:set var="pageTitle" value="고정자산 실사"/><%@ include file="../common/header.jsp" %><div class="page-head"><div><span class="eyebrow">ASSET INSPECTION</span><h1>고정자산 실사 등록</h1></div></div><c:if test="${param.success eq '1'}"><div class="alert success">실사 결과가 저장되었습니다.</div></c:if><section class="panel narrow"><form method="post" class="form-grid"><label class="span2">대상 자산<select name="assetNo" required><c:forEach items="${assets}" var="a"><option value="${a.assetNo}">${a.assetNo} · ${a.assetName} · ${a.department} · 최근실사 ${empty a.lastInspectedDate?'-':a.lastInspectedDate}</option></c:forEach></select></label><label>실사 결과<select name="result"><option value="NORMAL">정상</option><option value="MOVED">위치변경</option><option value="DAMAGED">파손</option><option value="MISSING">미확인</option></select></label><label>비고<input name="remark"></label><div class="span2 actions"><button class="btn primary">실사 저장</button></div></form></section><%@ include file="../common/footer.jsp" %>
